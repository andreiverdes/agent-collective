{
  "name": "agent-collective",
  "version": "0.4.1",
  "description": "Peer messaging between omp and pi sessions on one machine, scoped per omp profile: sessions find each other on demand by callsign and prompt each other with peers / peer_send.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module esnext --target es2022 --lib es2024 --moduleResolution bundler --types node index.ts",
    "package:dry-run": "npm pack --dry-run",
    "test": "bun --no-install test/acceptance.ts"
  },
  "keywords": [
    "agent-coordination",
    "callsign",
    "coding-agent",
    "cross-harness",
    "irc",
    "multi-agent",
    "omp",
    "omp-extension",
    "peer-discovery",
    "pi",
    "pi-coding-agent",
    "pi-extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@oh-my-pi/pi-coding-agent": ">=18.1.0 <19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreiverdes/agent-collective.git"
  },
  "bugs": {
    "url": "https://github.com/andreiverdes/agent-collective/issues"
  },
  "homepage": "https://github.com/andreiverdes/agent-collective#readme",
  "author": "andreiverdes (https://github.com/andreiverdes)",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.7.3"
  }
}
