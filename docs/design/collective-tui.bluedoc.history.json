 "html": {
  "58ae16a9f6f0724a": "<style>\n  .term { height: 100%; background: var(--bg); color: var(--fg); font: 13px/20px var(--mono); display: flex; flex-direction: column; padding-top: var(--safe-top); }\n  .bar { display: flex; gap: 16px; padding: 4px 12px; background: var(--surface); border-bottom: 1px solid var(--border); }\n  .bar b { color: var(--accent); font-weight: 600; }\n  .dim { color: var(--muted); }\n  .ok { color: var(--ok); } .warn { color: var(--warn); } .risk { color: var(--risk); } .acc { color: var(--accent); }\n  .body { flex: 1; display: grid; grid-template-columns: 1fr 380px; min-height: 0; }\n  .list { padding: 6px 0; border-right: 1px solid var(--border); overflow: hidden; }\n  .row { display: grid; grid-template-columns: 20px 200px 96px 1fr 44px 104px 48px; padding: 0 12px; white-space: pre; }\n  .row.head { color: var(--muted); border-bottom: 1px solid var(--border); margin-bottom: 4px; }\n  .row.sel { background: color-mix(in srgb, var(--accent) 22%, transparent); }\n  .row.off { color: var(--muted); }\n  .sep { padding: 2px 12px; color: var(--muted); }\n  .side { padding: 8px 14px; display: flex; flex-direction: column; gap: 10px; }\n  .kv { display: grid; grid-template-columns: 96px 1fr; white-space: pre; }\n  .kv span:nth-child(odd) { color: var(--muted); }\n  .box { border: 1px solid var(--border); padding: 6px 8px; }\n  .keys { padding: 4px 12px; border-top: 1px solid var(--border); background: var(--surface); color: var(--muted); white-space: pre; }\n  .keys b { color: var(--fg); font-weight: 600; }\n  .filter { padding: 4px 12px; border-bottom: 1px solid var(--border); white-space: pre; }\n</style>\n<main class=\"term\" data-bd=\"screen\">\n  <div class=\"bar\" data-bd=\"header\">\n    <span><b>collective</b> default</span>\n    <span>you are <span class=\"acc\">agent-collective-update</span> · omp</span>\n    <span class=\"dim\">14 running · 1 quiet · 2 offline · 3 contacts</span>\n  </div>\n  <div class=\"filter\" data-bd=\"filter\"><span class=\"dim\">/</span> <span class=\"dim\">filter by callsign or directory</span></div>\n  <div class=\"body\">\n    <section class=\"list\" data-bd=\"sessions\">\n      <div class=\"row head\"><span> </span><span>callsign</span><span>state</span><span>directory</span><span>via</span><span>where</span><span>seen</span></div>\n      <div class=\"sep\">contacts</div>\n      <div class=\"row sel\" data-bd=\"row-be-audio-001\" data-nav=\"omp-thread\" data-nav-label=\"Enter: open thread\"><span class=\"warn\">★</span><span>be-audio-001</span><span class=\"acc\">● working</span><span>.worktrees/be-audio</span><span>omp</span><span>Tern 3</span><span>40s</span></div>\n      <div class=\"row\" data-bd=\"row-int-backend-001\"><span class=\"warn\">★</span><span>int-backend-001</span><span class=\"ok\">○ idle</span><span>.worktrees/int-backend</span><span>omp</span><span>Tern 7</span><span>2m</span></div>\n      <div class=\"row\" data-bd=\"row-big-boss\"><span class=\"warn\">★</span><span>big-boss</span><span class=\"ok\">○ idle</span><span>stanbam-umbrella</span><span>omp</span><span>Tern 1</span><span>1m</span></div>\n      <div class=\"sep\">others</div>\n      <div class=\"row\" data-bd=\"row-be-foundation-001\"><span> </span><span>be-foundation-001</span><span class=\"acc\">● working</span><span>.worktrees/be-foundation</span><span>omp</span><span>Tern 4</span><span>12s</span></div>\n      <div class=\"row\" data-bd=\"row-be-ops-001\"><span> </span><span>be-ops-001</span><span class=\"acc\">● working</span><span>.worktrees/be-ops</span><span>omp</span><span>Tern 5</span><span>30s</span></div>\n      <div class=\"row\" data-bd=\"row-be-push-001\"><span> </span><span>be-push-001</span><span class=\"warn\">◌ quiet</span><span>.worktrees/be-push</span><span>omp</span><span>Tern 6</span><span>7m</span></div>\n      <div class=\"row\" data-bd=\"row-be-rekognition-001\"><span> </span><span>be-rekognition-001</span><span class=\"ok\">○ idle</span><span>.worktrees/be-rekognitio